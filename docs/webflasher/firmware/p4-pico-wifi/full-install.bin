$('#file').addEventListener('change',e=>{
  const f=e.target.files[0]; $('#fileLabel').textContent=f?`${f.name} В· ${size(f.size)}`:'Choose JPEG, PNG, GIF, BMP, or WebP';
});

const TYPEN_IMAGE_MAX_EDGE=1024;

function isJpegFile(f){
  const n=String(f.name||'').toLowerCase();
  return f.type==='image/jpeg'||n.endsWith('.jpg')||n.endsWith('.jpeg');
}

function isPngFile(f){
  const n=String(f.name||'').toLowerCase();
  return f.type==='image/png'||n.endsWith('.png');
}

function isWebpFile(f){
  const n=String(f.name||'').toLowerCase();
  return f.type==='image/webp'||n.endsWith('.webp');
}

async function webpIsAnimated(file){
  const bytes=new Uint8Array(await file.slice(0,256).arrayBuffer());
  if(bytes.length<12)return false;
  const tag=(o,n)=>String.fromCharCode(...bytes.slice(o,o+n));
  const u32=o=>bytes[o]|(bytes[o+1]<<8)|(bytes[o+2]<<16)|(bytes[o+3]<<24);
  if(tag(0,4)!=='RIFF'||tag(8,4)!=='WEBP')return false;
  let p=12;
  while(p+8<=bytes.length){
    const fourcc=tag(p,4),len=u32(p+4)>>>0,data=p+8;
    if(fourcc==='ANIM'||fourcc==='ANMF')return true;
    if(fourcc==='VP8X'&&len>=1&&data<bytes.length)return (bytes[data]&2)!==0;
    const next=data+len+(len&1);if(next<=p||next>bytes.length)break;p=next;
  }
  return false;
}

async function loadUploadImage(file){
  if('createImageBitmap' in window){
    try{return await createImageBitmap(file,{imageOrientation:'from-image'})}catch(e){}
    try{return await createImageBitmap(file)}catch(e){}
  }
  return await new Promise((resolve,reject)=>{
    const url=URL.createObjectURL(file),img=new Image();
    img.onload=()=>{URL.revokeObjectURL(url);resolve(img)};
    img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('Unable to decode image in browser'))};
    img.src=url;
  });
}

function canvasJpegBlob(canvas,quality){
  return new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('JPEG conversion failed')),'image/jpeg',quality));
}

function canvasPngBlob(canvas){
  return new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('PNG conversion failed')),'image/png'));
}

function canvasWebpBlob(canvas){
  return new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('WebP conversion failed')),'image/webp',.90));
}

async function prepareJpegUpload(file){
  $('#uploadDetail').textContent='Optimizing JPEG for TypeN hardware decodeвЂ¦';
  const image=await loadUploadImage(file);
  const sw=Number(image.width||image.naturalWidth)||0,sh=Number(image.height||image.naturalHeight)||0;
  if(!sw||!sh)throw new Error('Unable to determine JPEG dimensions');
  const scale=Math.min(1,TYPEN_IMAGE_MAX_EDGE/Math.max(sw,sh));
  let dw=Math.max(8,Math.round((sw*scale)/8)*8),dh=Math.max(8,Math.round((sh*scale)/8)*8);
  dw=Math.max(8,Math.min(TYPEN_IMAGE_MAX_EDGE,Math.floor(dw/8)*8));
  dh=Math.max(8,Math.min(TYPEN_IMAGE_MAX_EDGE,Math.floor(dh/8)*8));
  const canvas=document.createElement('canvas');canvas.width=dw;canvas.height=dh;
  const ctx=canvas.getContext('2d',{alpha:false});if(!ctx)throw new Error('Canvas unavailable');
  ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';
  ctx.fillStyle='#000';ctx.fillRect(0,0,dw,dh);ctx.drawImage(image,0,0,dw,dh);
  if(image.close)try{image.close()}catch(e){}
  const blob=await canvasJpegBlob(canvas,.90);
  return {blob:blob,name:file.name,detail:`JPEG optimized ${sw}Г—${sh} в†’ ${dw}Г—${dh} В· ${size(file.size)} в†’ ${size(blob.size)}`};
}

async function preparePngUpload(file){
  $('#uploadDetail').textContent='Checking PNG dimensionsвЂ¦';
  const image=await loadUploadImage(file);
  const sw=Number(image.width||image.naturalWidth)||0,sh=Number(image.height||image.naturalHeight)||0;
  if(!sw||!sh){if(image.close)try{image.close()}catch(e){};throw new Error('Unable to determine PNG dimensions')}
  if(Math.max(sw,sh)<=TYPEN_IMAGE_MAX_EDGE){
    if(image.close)try{image.close()}catch(e){}
    return {blob:file,name:file.name,detail:`PNG ${sw}Г—${sh} already within TypeN ${TYPEN_IMAGE_MAX_EDGE}px limit В· ${size(file.size)}`};
  }
  let dw,dh;
  if(sw>=sh){dw=TYPEN_IMAGE_MAX_EDGE;dh=Math.max(1,Math.round(sh*TYPEN_IMAGE_MAX_EDGE/sw))}
  else{dh=TYPEN_IMAGE_MAX_EDGE;dw=Math.max(1,Math.round(sw*TYPEN_IMAGE_MAX_EDGE/sh))}
  const canvas=document.createElement('canvas');canvas.width=dw;canvas.height=dh;
  const ctx=canvas.getContext('2d',{alpha:true});if(!ctx)throw new Error('Canvas unavailable');
  ctx.clearRect(0,0,dw,dh);ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.drawImage(image,0,0,dw,dh);
  if(image.close)try{image.close()}catch(e){}
  const blob=await canvasPngBlob(canvas);
  return {blob:blob,name:file.name,detail:`PNG resized ${sw}Г—${sh} в†’ ${dw}Г—${dh} В· transparency preserved В· ${size(file.size)} в†’ ${size(blob.size)}`};
}

async function prepareWebpUpload(file){
  $('#uploadDetail').textContent='Checking WebPвЂ¦';
  if(await webpIsAnimated(file))throw new Error('Animated WebP is not supported; use GIF for animation.');
  $('#uploadDetail').textContent='Checking WebP dimensionsвЂ¦';
  const image=await loadUploadImage(file);
  const sw=Number(image.width||image.naturalWidth)||0,sh=Number(image.height||image.naturalHeight)||0;
  if(!sw||!sh){if(image.close)try{image.close()}catch(e){};throw new Error('Unable to determine WebP dimensions')}
  if(Math.max(sw,sh)<=TYPEN_IMAGE_MAX_EDGE){
    if(image.close)try{image.close()}catch(e){}
    return {blob:file,name:file.name,detail:`WebP ${sw}Г—${sh} already within TypeN ${TYPEN_IMAGE_MAX_EDGE}px limit В· ${size(file.size)}`};
  }
  let dw,dh;
  if(sw>=sh){dw=TYPEN_IMAGE_MAX_EDGE;dh=Math.max(1,Math.round(sh*TYPEN_IMAGE_MAX_EDGE/sw))}
  else{dh=TYPEN_IMAGE_MAX_EDGE;dw=Math.max(1,Math.round(sw*TYPEN_IMAGE_MAX_EDGE/sh))}
  const canvas=document.createElement('canvas');canvas.width=dw;canvas.height=dh;
  const ctx=canvas.getContext('2d',{alpha:true});if(!ctx)throw new Error('Canvas unavailable');
  ctx.clearRect(0,0,dw,dh);ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.drawImage(image,0,0,dw,dh);
  if(image.close)try{image.close()}catch(e){}
  const blob=await canvasWebpBlob(canvas);
  return {blob:blob,name:file.name,detail:`WebP resized ${sw}Г—${sh} в†’ ${dw}Г—${dh} В· alpha preserved В· ${size(file.size)} в†’ ${size(blob.size)}`};
}

async function prepareUpload(file){
  if(isJpegFile(file))return await prepareJpegUpload(file);
  if(isPngFile(file))return await preparePngUpload(file);
  if(isWebpFile(file))return await prepareWebpUpload(file);
  return {blob:file,name:file.name,detail:''};
}

async function upload(){
  const f=$('#file').files[0];if(!f){toast('Choose a JPEG, PNG, GIF, BMP, or WebP first.');return}
  const btn=$('#uploadBtn'),bar=$('#uploadProgress');btn.disabled=true;bar.style.width='0%';
  try{
    const prepared=await prepareUpload(f);
    if(prepared.detail)$('#uploadDetail').textContent=prepared.detail;
    const x=new XMLHttpRequest();
    x.open('POST','/api/upload?name='+encodeURIComponent(prepared.name));
    x.upload.onprogress=e=>{if(e.lengthComputable)bar.style.width=((e.loaded/e.total)*100).toFixed(1)+'%'};
    x.onload=async()=>{btn.disabled=false;if(x.status>=200&&x.status<300){bar.style.width='100%';toast('Upload complete');$('#file').value='';$('#fileLabel').textContent='Choose JPEG, PNG, GIF, BMP, or WebP';await refreshMedia()}else toast(x.responseText||'Upload failed')};
    x.onerror=()=>{btn.disabled=false;toast('Upload failed')};
    x.send(prepared.blob);
  }catch(e){btn.disabled=false;$('#uploadDetail').textContent='';toast(e.message||'Unable to prepare upload')}
}

async function selectMedia(path){
  try{
    const r=await fetch('/api/select',{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:path});
    const t=await r.text();if(!r.ok)throw new Error(t);
    media.forEach(m=>{m.selected=(m.path===path)});info.selectedPath=path;render();
    toast('Active media updated');
    await refreshMedia();
  }catch(e){toast(e.message||'Selection failed')}
}

let pendingDelete=null;

function askDelete(path,name){
  pendingDelete={path:path,name:name};
  $('#deleteConfirmName').textContent=name+'\n'+path;
  $('#deleteConfirmButton').disabled=false;
  setDialogVisible('#deleteConfirm',true);
}

function closeDeleteConfirm(){
  if($('#deleteConfirmButton').disabled)return;
  pendingDelete=null;setDialogVisible('#deleteConfirm',false);
}

async function confirmDelete(){
  if(!pendingDelete)return;
  const item=pendingDelete,button=$('#deleteConfirmButton');
  button.disabled=true;button.textContent='DeletingвЂ¦';
  try{
    const r=await fetch('/api/delete?path='+encodeURIComponent(item.path),{method:'POST',cache:'no-store'});
    const t=await r.text();if(!r.ok)throw new Error(t||'Delete failed');
    pendingDelete=null;setDialogVisible('#deleteConfirm',false);toast('Deleted '+item.name);await refreshMedia();
  }catch(e){toast(e.message||'Delete failed')}
  finally{button.disabled=false;button.textContent='Delete'}
}

$('#deleteConfirm').addEventListener('click',e=>{if(e.target.id==='deleteConfirm')closeDeleteConfirm()});

$('#firmwareFile').addEventListener('change',e=>{
  const f=e.target.files[0];
  $('#firmwareFileLabel').textContent=f?`${f.name} В· ${size(f.size)}`:'Choose TypeN firmware';
});

let updatePollTimer=0,updatePollRunning=false,lastUpdateState='idle',pendingUpdateAction=null;

function setUpdateNotice(kind,text){
  const n=$('#updateNotice');
  n.className='update-notice'+(kind?' '+kind:'');
  n.textContent=text;
}

function setUpdateBadge(state){
  const b=$('#updateState');
  b.textContent=String(state||'idle').toUpperCase();
  const kind=state==='error'?'error':state==='rebooting'?'good':['preparing','writing','verifying'].includes(state)?'busy':'';
  b.className='badge'+(kind?' '+kind:'');
}

function openUpdateConfirm(action,title,text,details){
  pendingUpdateAction=action;
  $('#updateConfirmTitle').textContent=title;
  $('#updateConfirmText').textContent=text;
  $('#updateConfirmDetails').textContent=details;
  $('#updateConfirmButton').disabled=false;
  $('#updateConfirmButton').textContent='Install update';
  setDialogVisible('#updateConfirm',true);
}

function closeUpdateConfirm(){
  if($('#updateConfirmButton').disabled)return;
  pendingUpdateAction=null;
  setDialogVisible('#updateConfirm',false);
}

$('#updateConfirm').addEventListener('click',e=>{if(e.target.id==='updateConfirm')closeUpdateConfirm()});

function scheduleUpdatePoll(delay=300){
  clearTimeout(updatePollTimer);
  updatePollTimer=setTimeout(()=>refreshUpdateStatus(true),delay);
}

async function refreshUpdateStatus(scheduleNext=true){
  if(updatePollRunning)return;
  updatePollRunning=true;
  let busy=false;
  try{
    const r=await fetch('/api/update/status',{cache:'no-store'});
    if(!r.ok)throw new Error('Status request failed');
    const u=await r.json();
    const state=String(u.state||'idle');
    lastUpdateState=state;
    const total=Number(u.total)||0,written=Number(u.written)||0;
    const pct=total>0?Math.max(0,Math.min(100,(written/total)*100)):0;
    setUpdateBadge(state);
    $('#runningVersion').textContent=u.runningVersion||'вЂ”';
    $('#runningIdentity').textContent=u.runningVariant?`${u.runningVariant} В· ABI ${u.runningAbi||'?'}`:'вЂ”';
    $('#runningSlot').textContent=u.running||'вЂ”';
    $('#bootSlot').textContent=u.boot||'вЂ”';
    $('#imageState').textContent=u.imageState||'вЂ”';
    $('#targetVersion').textContent=u.targetVersion||'вЂ”';
    $('#targetIdentity').textContent=u.targetVariant?`${u.targetVariant} В· ABI ${u.targetAbi||'?'}`:'вЂ”';
    $('#targetSlot').textContent=u.target||'вЂ”';
    $('#lastUpdateResult').textContent=(u.lastResult||'none').replace('_',' ').toUpperCase();
    $('#lastUpdateVersion').textContent=u.lastVersion||'вЂ”';
    $('#lastUpdateSlot').textContent=u.lastPartition||'вЂ”';
    $('#rollbackState').textContent=u.rollbackPossible?'Available':'Not available';
    $('#invalidImage').textContent=u.invalidPartition?`${u.invalidVersion||'unknown'} В· ${u.invalidPartition}`:'None';
    $('#updatePercent').textContent=pct.toFixed(0)+'%';
    $('#updateMessage').textContent=u.message||'Updater ready';
    $('#updateProgress').style.width=pct.toFixed(1)+'%';
    busy=['preparing','writing','verifying','rebooting'].includes(state);
    $('#firmwareUploadBtn').disabled=busy;
    $('#sdUpdateBtn').disabled=busy;
    if(state==='error')setUpdateNotice('error',u.message||'Firmware update failed.');
    else if(state==='rebooting')setUpdateNotice('good','Firmware verified and installed. TypeN is rebooting into the new image.');
    else if(state==='verifying')setUpdateNotice('busy','Firmware written. TypeN is validating the image before changing the boot slot.');
    else if(state==='writing')setUpdateNotice('busy',`Writing firmware to ${u.target||'the inactive OTA slot'} вЂ” ${pct.toFixed(0)}% complete.`);
    else if(state==='preparing')setUpdateNotice('busy',u.message||'Preparing the inactive OTA slot.');
    else if(u.lastResult==='rolled_back')setUpdateNotice('error',`The previous update${u.lastVersion?' to '+u.lastVersion:''} did not reach confirmation and was rolled back. TypeN is running ${u.runningVersion||'the previous firmware'} from ${u.running||'the working slot'}.`);
    else if(u.lastResult==='confirmed'&&u.lastPartition===u.running)setUpdateNotice('good',`Firmware ${u.runningVersion||u.lastVersion||''} is confirmed and running from ${u.running||'the active OTA slot'}.`);
    else if(u.lastResult==='pending')setUpdateNotice('busy',`Firmware ${u.lastVersion||''} is awaiting confirmation on ${u.lastPartition||'the new OTA slot'}.`);
    else setUpdateNotice('',`Updater ready. Running ${u.runningVersion||'the current firmware'} from ${u.running||'the current application slot'}.`);
  }catch(e){
    if(lastUpdateState==='rebooting')setUpdateNotice('good','TypeN is rebooting. The web connection may disappear briefly; reconnect to TypeN Setup if needed.');
  }finally{
    updatePollRunning=false;
    if(scheduleNext){
      const fast=['preparing','writing','verifying','rebooting'].includes(lastUpdateState);
      scheduleUpdatePoll(fast?1000:8000);
    }
  }
}

async function uploadFirmware(){
  const f=$('#firmwareFile').files[0];
  if(!f){toast('Choose the TypeN application .bin first.');return}
  if(!String(f.name).toLowerCase().endsWith('.bin')){toast('Firmware must be the TypeN application .bin');return}
  const btn=$('#firmwareUploadBtn');
  btn.disabled=true;
  setUpdateBadge('preparing');
  setUpdateNotice('busy','Checking the firmware image before installationвЂ¦');
  try{
    const prefix=await f.slice(0,512).arrayBuffer();
    const r=await fetch('/api/update/upload/check?size='+encodeURIComponent(f.size),{
      method:'POST',
      cache:'no-store',
      headers:{'Content-Type':'application/octet-stream'},
      body:prefix
    });
    const text=await r.text();
    if(!r.ok)throw new Error(text||'Unable to check firmware image');
    const info=JSON.parse(text);
    if(!info.valid){
      setUpdateBadge('error');
      setUpdateNotice('error',info.message||'The selected firmware image is not valid.');
      toast(info.message||'Firmware preflight failed');
      return;
    }
    setUpdateBadge('idle');
    setUpdateNotice('good',info.message||'Firmware image is ready to install.');
    openUpdateConfirm(
      {kind:'browser',file:f,info:info},
      'Install uploaded firmware?',
      'The file has passed the TypeN application checks. Installation writes the inactive OTA slot and reboots only after full ESP-IDF verification.',
      `${f.name}\nProject: ${info.project||'TypeN'}\nVersion: ${info.version||'unknown'}\nVariant: ${info.variant||'unknown'}\nFirmware ABI: ${info.abi||'unknown'}\nSize: ${size(info.size)}\nSlot: ${info.running||'current'} в†’ ${info.target||'inactive'}`
    );
  }catch(e){
    setUpdateBadge('error');
    setUpdateNotice('error',e.message||'Unable to check firmware image.');
    toast(e.message||'Firmware preflight failed');
  }finally{
    btn.disabled=false;
  }
}

async function installFromSd(){
  const path=$('#sdUpdatePath').value.trim();
  if(!path.startsWith('/sdcard/')||!path.toLowerCase().endsWith('.bin')){toast('Choose a .bin file inside /sdcard');return}
  const btn=$('#sdUpdateBtn');btn.disabled=true;
  setUpdateBadge('preparing');
  setUpdateNotice('busy','Checking the SD firmware image before installationвЂ¦');
  try{
    const r=await fetch('/api/update/sd/check?path='+encodeURIComponent(path),{cache:'no-store'});
    if(!r.ok)throw new Error(await r.text()||'Unable to check SD firmware');
    const info=await r.json();
    if(!info.valid){
      setUpdateBadge('error');
      setUpdateNotice('error',info.message||'The SD firmware image is not valid.');
      toast(info.message||'SD firmware check failed');
      return;
    }
    setUpdateBadge('idle');
    setUpdateNotice('good',info.message||'Firmware image is ready to install.');
    openUpdateConfirm(
      {kind:'sd',path:path,info:info},
      'Install firmware from SD?',
      'The file has passed the TypeN preflight checks. Installation writes the inactive OTA slot and reboots only after verification.',
      `${path}\nProject: ${info.project||'TypeN'}\nVersion: ${info.version||'unknown'}\nVariant: ${info.variant||'unknown'}\nFirmware ABI: ${info.abi||'unknown'}\nSize: ${size(info.size)}\nSlot: ${info.running||'current'} в†’ ${info.target||'inactive'}`
    );
  }catch(e){
    setUpdateBadge('error');
    setUpdateNotice('error',e.message||'Unable to check SD firmware.');
    toast(e.message||'SD firmware check failed');
  }finally{btn.disabled=false}
}

async function confirmUpdateAction(){
  if(!pendingUpdateAction)return;
  const action=pendingUpdateAction,button=$('#updateConfirmButton');
  button.disabled=true;button.textContent='StartingвЂ¦';
  if(action.kind==='browser'){
    $('#updateConfirm').classList.remove('show');
    pendingUpdateAction=null;
    startBrowserFirmware(action.file,action.info);
    button.disabled=false;button.textContent='Install update';
    return;
  }
  try{
    setUpdateBadge('preparing');
    setUpdateNotice('busy','Starting SD firmware installationвЂ¦');
    const r=await fetch('/api/update/sd?path='+encodeURIComponent(action.path),{method:'POST',cache:'no-store'});
    const t=await r.text();
    if(!r.ok)throw new Error(t||'Unable to start SD update');
    pendingUpdateAction=null;
    $('#updateConfirm').classList.remove('show');
    toast('SD firmware update started');
    scheduleUpdatePoll(150);
  }catch(e){
    setUpdateBadge('error');
    setUpdateNotice('error',e.message||'SD update failed to start.');
    toast(e.message||'SD update failed');
  }finally{button.disabled=false;button.textContent='Install update'}
}

function startBrowserFirmware(f,info){
  const btn=$('#firmwareUploadBtn'),bar=$('#firmwareProgress');
  btn.disabled=true;bar.style.width='0%';
  setUpdateBadge('preparing');
  setUpdateNotice('busy',`Uploading ${info&&info.version?info.version:'firmware'} to TypeNвЂ¦`);
  const x=new XMLHttpRequest();
  x.open('POST','/api/update/upload');
  x.setRequestHeader('Content-Type','application/octet-stream');
  x.upload.onprogress=e=>{
    if(e.lengthComputable){
      const pct=(e.loaded/e.total)*100;
      bar.style.width=pct.toFixed(1)+'%';
      $('#updateProgress').style.width=pct.toFixed(1)+'%';
      $('#updatePercent').textContent=pct.toFixed(0)+'%';
      setUpdateNotice('busy',`Uploading firmware вЂ” ${pct.toFixed(0)}% transmitted.`);
    }
  };
  x.onload=()=>{
    if(x.status>=200&&x.status<300){
      bar.style.width='100%';
      toast('Firmware verified. TypeN is rebooting.');
      scheduleUpdatePoll(150);
    }else{
      btn.disabled=false;
      setUpdateBadge('error');
      setUpdateNotice('error',x.responseText||'Firmware update failed.');
      toast(x.responseText||'Firmware update failed');
      scheduleUpdatePoll(150);
    }
  };
  x.onerror=()=>{
    btn.disabled=false;
    setUpdateNotice(lastUpdateState==='rebooting'?'good':'error',lastUpdateState==='rebooting'?'TypeN is rebooting into the new firmware.':'Firmware upload connection failed.');
    scheduleUpdatePoll(300);
  };
  x.send(f);
}


let managementStarted=false;
async function startManagementApp(){
  if(managementStarted)return;managementStarted=true;
  await loadInfo(); await refreshMedia(); await refreshUpdateStatus(true);
  if($('#view-diagnostics').classList.contains('active'))await loadDiagnostics();
}
(async()=>{
  const initial=location.hash.slice(1);if(['media','settings','update','diagnostics','about'].includes(initial))setView(initial);
  const a=await loadAuthStatus();
  if(a.enabled&&!a.authenticated){
    const wait=a.lockoutSeconds>0?`Try again in ${a.lockoutSeconds}s.`:'';showAuthGate(wait);return;
  }
  hideAuthGate();await startManagementApp();
})();
</script>
</body>
