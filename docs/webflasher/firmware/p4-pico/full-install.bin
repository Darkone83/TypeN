Н(НЄНµМэНпМjН|МЪНµМЧ␀Н|МBюНjЖmщНпВѕчН_ВЧцН“А+цН<АЎчНББшНВMшНХГ4щНтГъНћДЖъНШД“ьНХГМьНёГ"эН»ДПэНхДХяНчЕћ␀НчЕKНjЖЎНMЖ1НKЕБНЕ9НћДЙНћД<НKЕ“НћДІН„ЕТНѕЕpНMЖЄ3ыНЪ3ыbНћ
3ы(НЄ3ыµМэ3ыпМj3ы|МЪ3ыµМЧ␀3ы|МBю3ыjЖmщ3ыпВѕч3ы_ВЧц3ы“А+ц3ы<АЎч3ыББш3ыВMш3ыХГ4щ3ытГъ3ыћДЖъ3ыШД“ь3ыХГМь3ыёГ"э3ы»ДПэ3ыхДХя3ычЕћ␀3ычЕK3ыjЖЎ3ыMЖ13ыKЕБ3ыЕ93ыћДЙ3ыћД<3ыKЕ“3ыћДІ3ы„ЕТ3ыѕЕp3ыtypen_wifi_enable_captive_portal␀␀␀␀configure_ap_netif␀␀typen_wifi_start␀␀␀␀0123456789abcdef␀␀␀␀typen_web_start␀<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070a08">
<title>TypeN Control</title>
<style>
:root{
  --bg:#070a08;--bg2:#0b0f0c;--panel:#101612;--panel2:#141b16;
  --line:#243129;--line2:#314338;--text:#f3f7f4;--muted:#8fa198;
  --green:#48d67c;--green2:#2fbf67;--green-dim:#173522;--danger:#ff7f8a;
  --radius:18px;--shadow:0 16px 50px rgba(0,0,0,.32);
}
*{box-sizing:border-box}
html{background:var(--bg);color-scheme:dark}
body{
  margin:0;min-height:100vh;background:
  radial-gradient(circle at 18% -10%,rgba(72,214,124,.08),transparent 30rem),
  linear-gradient(180deg,var(--bg2),var(--bg));
  color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
}
button,input{font:inherit}
button{cursor:pointer}
.app{min-height:100vh;display:grid;grid-template-rows:auto 1fr auto}
.topbar{
  position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;
  gap:14px;padding:14px max(16px,env(safe-area-inset-left));
  background:rgba(7,10,8,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(72,214,124,.12)
}
.brand{display:flex;align-items:center;gap:11px;min-width:0}
.logo{
  width:38px;height:38px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto;
  border:1px solid var(--green);color:var(--green);font-weight:900;font-size:16px;
  box-shadow:0 0 24px rgba(72,214,124,.18),inset 0 0 18px rgba(72,214,124,.06)
}
.brand-copy{min-width:0}.brand-name{font-weight:800;letter-spacing:.02em}.brand-sub{font-size:11px;color:var(--muted);margin-top:1px}
.connection{display:flex;align-items:center;gap:8px;font-size:12px;color:#b9c9c0;white-space:nowrap}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green)}
.layout{width:min(100%,1360px);margin:0 auto;display:grid;grid-template-columns:1fr}
.nav{
  display:flex;gap:6px;overflow-x:auto;padding:10px 12px;border-bottom:1px solid var(--line);
  background:rgba(9,13,10,.92);scrollbar-width:none
}
.nav::-webkit-scrollbar{display:none}
.nav button{
  min-height:42px;border:1px solid transparent;border-radius:12px;padding:8px 13px;
  background:transparent;color:var(--muted);font-weight:700;white-space:nowrap
}
.nav button.active{background:var(--green-dim);border-color:#28563a;color:#dff9e8}
.content{min-width:0;padding:18px 14px 90px}
.view{display:none}.view.active{display:block}
.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:16px}
.hero h1{margin:0;font-size:clamp(24px,4.5vw,38px);letter-spacing:-.035em}
.hero p{margin:6px 0 0;color:var(--muted);font-size:14px}
.hero-meta{display:none;text-align:right;color:var(--muted);font-size:12px}
.grid{display:grid;grid-template-columns:1fr;gap:14px}
.card{
  min-width:0;background:linear-gradient(180deg,rgba(20,27,22,.96),rgba(14,19,16,.96));
  border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px
}
.card-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}
.card-title h2{margin:0;font-size:15px;letter-spacing:.015em}.eyebrow{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--green)}
.now-playing{border-color:#28533a;background:linear-gradient(145deg,#132119,#0e1511)}
.now-path{font-size:13px;color:#d9e7de;overflow-wrap:anywhere;line-height:1.45}
.muted{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.stat{background:#0b100d;border:1px solid #1e2922;border-radius:14px;padding:12px}
.stat b{display:block;font-size:20px;margin-bottom:2px}.stat span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.upload-zone{display:grid;gap:11px}
.filepick{
  position:relative;min-height:110px;border:1px dashed #385446;border-radius:15px;
  background:#0b110d;display:grid;place-items:center;text-align:center;padding:18px
}
.filepick input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.filepick strong{display:block}.filepick span{display:block;color:var(--muted);font-size:12px;margin-top:5px}
.pathline{font:12px ui-monospace,SFMono-Regular,Consolas,monospace;color:#a7b8ae;overflow-wrap:anywhere}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.btn{
  min-height:44px;border-radius:12px;border:1px solid #324239;background:#151d18;color:var(--text);
  padding:9px 13px;font-weight:750
}
.btn.primary{background:var(--green2);border-color:var(--green2);color:#061009}
.btn.ghost{background:#0c110e}.btn.danger{color:#ffb2b8;border-color:#4b2a2e;background:#1a1012}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn:focus-visible,.search:focus-visible,.field input[type=text]:focus-visible,.field input[type=password]:focus-visible,.filepick:focus-within{outline:2px solid #69e492;outline-offset:2px}
.confirm-card .btn{min-height:46px}
.confirm-kicker{margin-bottom:7px;color:var(--green);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
.confirm-card.danger-confirm{border-color:#5a3135}.confirm-card.danger-confirm .confirm-kicker{color:#ff9ca5}
.auth-gate{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(4,7,5,.92);backdrop-filter:blur(14px)}
.auth-gate.hidden{display:none}.auth-card{width:min(100%,390px);background:#111713;border:1px solid #31503b;border-radius:20px;padding:22px;box-shadow:0 24px 80px #000c}
.auth-card h2{margin:0 0 7px;font-size:22px}.auth-card p{margin:0 0 16px;color:var(--muted);font-size:13px;line-height:1.5}.auth-status{min-height:18px;margin-top:10px;color:#ffb2b8;font-size:12px}
.field input[type=password]{width:100%;min-height:48px;border:1px solid #2d3b33;border-radius:12px;background:#0d120f;color:var(--text);padding:10px 12px;outline:none;font-size:18px;letter-spacing:.16em}
.field input[type=password]:focus{border-color:#3c7651;box-shadow:0 0 0 3px rgba(72,214,124,.08)}
.danger-card{border-color:#4b2a2e}.danger-card .eyebrow{color:#ff9ba4}
.progress{height:7px;border-radius:99px;background:#0a0e0c;overflow:hidden;border:1px solid #1b2620}
.progress>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--green2),#7cf0a5);transition:width .18s}
.update-status{display:grid;gap:9px}
.update-status-row{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-top:1px solid #202a24;font-size:12px}
.update-status-row:first-child{border-top:0;padding-top:0}
.update-status-row span:first-child{color:var(--muted)}
.update-status-row strong{font-weight:750;text-align:right;overflow-wrap:anywhere}
.update-notice{margin-top:13px;padding:11px 12px;border-radius:11px;border:1px solid #26342b;background:#0d1410;color:#a9bbb0;font-size:12px;line-height:1.45}
.update-notice.busy{border-color:#35533f;background:#0e1812;color:#c8ead3}.update-notice.good{border-color:#386c49;background:#0c1910;color:#c9f3d6}.update-notice.error{border-color:#6a3c3c;background:#1a1010;color:#f0c5c5}
.badge.busy{background:#1b2a20;border-color:#41614a;color:#d4f5de}.badge.good{background:#14271a;border-color:#3e714d;color:#cdf4d8}.badge.error{background:#2a1717;border-color:#754444;color:#f2caca}
.warning{border-left:3px solid #d6a648;padding:11px 13px;background:#17130b;color:#dccba8;border-radius:0 10px 10px 0;font-size:13px;line-height:1.5}
.toolbar{display:grid;grid-template-columns:1fr;gap:9px;margin-bottom:12px}
.search{
  min-height:44px;border-radius:12px;border:1px solid #2d3b33;background:#0d120f;color:var(--text);
  padding:10px 13px;outline:none;width:100%
}
.search:focus{border-color:#3c7651;box-shadow:0 0 0 3px rgba(72,214,124,.08)}
.media-grid{display:grid;grid-template-columns:1fr;gap:10px}
.media{
  display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:center;
  padding:11px;border:1px solid #233028;border-radius:15px;background:#0d120f
}
.media.active{border-color:#48d67c;background:#102017;box-shadow:inset 4px 0 0 #48d67c,inset 0 0 0 1px rgba(72,214,124,.12),0 0 18px rgba(72,214,124,.06)}
.media.active .media-name{color:#dcffe7}
.active-state{color:#7cf0a5;font-weight:850;letter-spacing:.04em}
.identity-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;padding:18px;border:1px solid #26372d;border-radius:18px;background:linear-gradient(145deg,#0b120e,#111a14)}
.identity-main small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.09em;margin-bottom:5px}
.identity-version{font-size:34px;font-weight:900;line-height:1;letter-spacing:-.04em}
.identity-chips{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px}.identity-chip{padding:7px 10px;border-radius:999px;border:1px solid #2c4535;background:#101a13;color:#b9d6c2;font-size:11px;font-weight:800}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.system-value{overflow-wrap:anywhere}.system-value.good{color:#7cf0a5}
@media(max-width:760px){.identity-hero{align-items:flex-start;flex-direction:column}.identity-chips{justify-content:flex-start}.about-grid{grid-template-columns:1fr}}
.btn:not(:disabled):active{transform:translateY(1px) scale(.985);filter:brightness(1.08)}
.btn.active-btn{background:#14271a;border-color:#3e714d;color:#bff5cf;opacity:1;cursor:default}
.thumb{
  position:relative;width:104px;aspect-ratio:196/88;border-radius:12px;overflow:hidden;
  display:grid;place-items:center;background:radial-gradient(circle at 35% 25%,#1f3929,#0b100d 68%);
  border:1px solid #283a30;font-weight:900;font-size:12px;color:#8fe4ab
}
.thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;background:#080b09}
.thumb .fallback{position:relative;z-index:0;letter-spacing:.08em}
.thumb img:not([src]){display:none}
.media-main{min-width:0}.media-name{font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.media-path{font-size:11px;color:var(--muted);margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.media-meta{display:flex;gap:7px;align-items:center;margin-top:7px;color:#84958c;font-size:11px}
.badge{padding:2px 7px;border-radius:999px;background:#17231b;border:1px solid #294033;color:#a7d7b7;font-size:10px;font-weight:800}
.media-actions{grid-column:1/-1;display:flex;gap:7px}
.media-actions .btn{flex:1;min-height:44px;font-size:12px}
.empty{padding:28px 10px;text-align:center;color:var(--muted)}
.section-stack{display:grid;gap:14px}
.setting-row{
  display:grid;gap:6px;padding:12px 0;border-top:1px solid #202a24
}
.setting-row:first-child{border-top:0;padding-top:0}
.setting-row b{font-size:13px}.setting-row span{font-size:12px;color:var(--muted);overflow-wrap:anywhere}
.field{display:grid;gap:7px;margin-top:12px}.field:first-child{margin-top:0}
.field label{font-size:12px;font-weight:750;color:#cdd9d1}
.field input[type=text]{
  width:100%;min-height:44px;border:1px solid #2d3b33;border-radius:12px;background:#0d120f;
  color:var(--text);padding:10px 12px;outline:none;font:12px ui-monospace,SFMono-Regular,Consolas,monospace
}
.field input[type=text]:focus{border-color:#3c7651;box-shadow:0 0 0 3px rgba(72,214,124,.08)}
.range-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
.range-value{font-size:26px;font-weight:850;color:#dff9e8;min-width:72px;text-align:right}
.range{width:100%;accent-color:var(--green);min-height:36px}
.readonly-box{
  margin-top:10px;padding:10px 12px;border:1px solid #243129;border-radius:12px;background:#0b100d;
  color:#9fb0a6;font:12px ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere
}
.save-row{display:flex;justify-content:flex-end;margin-top:13px}
.save-row .btn{width:100%}
@media(min-width:620px){.save-row .btn{width:auto;min-width:150px}}
.notice{border-left:3px solid var(--green);padding:11px 13px;background:#0d1510;color:#b9c9c0;border-radius:0 10px 10px 0;font-size:13px;line-height:1.5}
.bottom-space{height:8px}
.toast{
  position:fixed;left:50%;bottom:calc(76px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);
  z-index:50;width:min(calc(100% - 28px),520px);padding:12px 14px;border-radius:13px;background:#18211b;
  border:1px solid #35453b;color:#eef5f0;box-shadow:0 18px 50px #0008;opacity:0;pointer-events:none;transition:.2s
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.confirm-backdrop{position:fixed;inset:0;z-index:70;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.72);backdrop-filter:blur(7px)}
.confirm-backdrop.show{display:flex}.confirm-card{width:min(100%,430px);background:#111713;border:1px solid #314338;border-radius:18px;box-shadow:0 24px 70px #000a;padding:18px}
.confirm-card h3{margin:0 0 8px;font-size:18px}.confirm-card p{margin:0;color:#9fb0a6;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.confirm-name{margin-top:12px;padding:10px 12px;border-radius:12px;background:#0a0f0c;border:1px solid #26332b;font:12px ui-monospace,SFMono-Regular,Consolas,monospace;color:#e7efe9;white-space:pre-wrap;overflow-wrap:anywhere}
.confirm-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:16px}.upload-detail{min-height:18px;color:#8fa198;font-size:11px;line-height:1.45}
.secret-trigger{user-select:none;-webkit-user-select:none;touch-action:manipulation}
.easter-card{border-color:#7f2da8;background:linear-gradient(160deg,#160b19,#111217);box-shadow:0 24px 80px #000d,0 0 42px rgba(221,45,214,.18)}
.easter-kicker{margin-bottom:7px;color:#e92bd8;font-size:10px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
.btn.easter{background:linear-gradient(135deg,#71259c,#df2bcf);border-color:#e83ada;color:#fff}.confirm-actions.single{grid-template-columns:1fr}
.mobilebar{
  position:fixed;z-index:30;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(5,1fr);
  padding:7px 8px calc(7px + env(safe-area-inset-bottom));background:rgba(8,11,9,.94);
  backdrop-filter:blur(18px);border-top:1px solid #233028
}
.mobilebar button{
  min-height:48px;border:0;background:transparent;color:#75867d;border-radius:11px;font-size:11px;font-weight:800
}
.mobilebar button.active{color:#c9f6d8;background:#14241a}
.desktop-note{display:none}
@media(min-width:620px){
  .content{padding:22px 20px 95px}.toolbar{grid-template-columns:minmax(220px,1fr) auto}.media-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .stats{grid-template-columns:repeat(4,1fr)}
}
@media(min-width:900px){
  .layout{grid-template-columns:210px minmax(0,1fr)}
  .nav{position:sticky;top:67px;height:calc(100vh - 67px);align-self:start;flex-direction:column;overflow:visible;padding:22px 14px;border-right:1px solid var(--line);border-bottom:0;background:#0a0e0b}
  .nav button{text-align:left;width:100%;padding:10px 12px}.content{padding:28px 26px 50px}.mobilebar{display:none}.toast{bottom:24px}.hero-meta{display:block}
  .grid.dashboard{grid-template-columns:minmax(0,1.45fr) minmax(280px,.7fr)}.desktop-note{display:block}
}
@media(min-width:1180px){
  .media-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.card{padding:18px}.content{padding-left:34px;padding-right:34px}
}
@media(hover:hover){
  .btn:hover{border-color:#476052;transform:translateY(-1px)}.btn.primary:hover{filter:brightness(1.06)}
  .nav button:hover,.mobilebar button:hover{color:#d5e7dc}
}
</style>
</head>
<body>
<div id="authGate" class="auth-gate">
  <div class="auth-card">
    <div class="eyebrow" style="margin-bottom:6px">TypeN management</div>
    <h2>Admin PIN</h2>
    <p>Enter the device PIN to manage media, settings, or firmware.</p>
    <div class="field"><label for="authPin">PIN</label><input id="authPin" type="password" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="8" autocomplete="current-password"></div>
    <div class="save-row"><button id="authUnlockBtn" class="btn primary" onclick="unlockAdmin()">Unlock</button></div>
    <div id="authStatusText" class="auth-status"></div>
  </div>
</div>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="logo">N</div>
      <div class="brand-copy"><div class="brand-name">TypeN</div><div class="brand-sub">local control surface</div></div>
    </div>
    <div class="connection"><i class="dot"></i><span id="ip">connecting</span></div>
  </header>

  <div class="layout">
    <nav class="nav" aria-label="TypeN sections">
      <button class="active" data-view="media">Media</button>
      <button data-view="settings">Settings</button>
      <button data-view="update">Update</button>
      <button data-view="diagnostics">Diagnostics</button>
      <button data-view="about">About</button>
    </nav>

    <main class="content">
      <section id="view-media" class="view active">
        <div class="hero">
          <div><h1>Media</h1><p>Manage what TypeN displays without leaving the local network.</p></div>
          <div class="hero-meta"><div>ESP32-P4 + C6</div><div>800 Г— 800 RGB565</div></div>
        </div>

        <div class="grid dashboard">
          <div class="section-stack">
            <article class="card now-playing">
              <div class="card-title"><div><div class="eyebrow">Active media</div><h2 id="selectedName">No active media</h2></div><span class="badge" id="selectedType">IDLE</span></div>
              <div class="now-path" id="selectedPath">вЂ”</div>
            </article>

            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Library</div><h2>Media on TypeN</h2></div><span class="badge" id="mediaCount">0 items</span></div>
              <div class="toolbar">
                <input class="search" id="search" type="search" placeholder="Search filename or path" autocomplete="off">
                <button class="btn ghost" onclick="refreshMedia()">Refresh</button>
              </div>
              <div id="mediaGrid" class="media-grid"><div class="empty">Loading mediaвЂ¦</div></div>
            </article>
          </div>

          <div class="section-stack">
            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Add media</div><h2>Upload to SD</h2></div></div>
              <div class="upload-zone">
                <label class="filepick">
                  <input id="file" type="file" accept=".jpg,.jpeg,.png,.gif,.bmp,.webp,image/jpeg,image/png,image/gif,image/bmp,image/webp">
                  <div><strong id="fileLabel">Choose JPEG, PNG, GIF, BMP, or WebP</strong><span>Tap to browse this device</span></div>
                </label>
                <div><div class="muted" style="font-size:11px;margin-bottom:4px">Destination</div><div class="pathline" id="uploadPath">вЂ¦</div></div>
                <div class="progress"><i id="uploadProgress"></i></div>
                <div id="uploadDetail" class="upload-detail"></div>
                <div class="actions"><button id="uploadBtn" class="btn primary" onclick="upload()">Upload</button></div>
              </div>
            </article>

            <article class="card">
              <div class="card-title"><div><div class="eyebrow">System</div><h2>At a glance</h2></div></div>
              <div class="stats">
                <div class="stat"><b id="statMedia">0</b><span>Media</span></div>
                <div class="stat"><b id="statActive">IDLE</b><span>Active</span></div>
                <div class="stat"><b id="statVersion">вЂ”</b><span>Firmware</span></div>
                <div class="stat"><b id="statSlot">вЂ”</b><span>App slot</span></div>
              </div>
              <div class="setting-row" style="margin-top:12px"><b>Wi-Fi</b><span id="statIp" class="system-value good">вЂ”</span></div>
            </article>
          </div>
        </div>
      </section>

      <section id="view-settings" class="view">
        <div class="hero"><div><h1>Settings</h1><p>Persistent TypeN settings shared by the touch UI and this control surface.</p></div></div>
        <div class="grid">
          <article class="card">
            <div class="card-title"><div><div class="eyebrow">Storage</div><h2>Media paths</h2></div></div>

            <div class="field">
              <label for="uploadPathInput">Upload destination</label>
              <input id="uploadPathInput" type="text" maxlength="511" spellcheck="false" autocomplete="off" placeholder="/sdcard/typen/media">
            </div>

            <div class="field">
              <label for="thumbnailPathInput">Thumbnail path</label>
              <input id="thumbnailPathInput" type="text" maxlength="511" spellcheck="false" autocomplete="off" placeholder="/sdcard/typen/thumbs">
            </div>

            <div class="field">
              <label>Active media</label>
              <div class="readonly-box" id="settingsSelectedPath">None</div>
            </div>

            <div class="save-row"><button class="btn primary" onclick="savePaths()">Save paths</button></div>
          </article>

          <article class="card">
            <div class="card-title"><div><div class="eyebrow">Display</div><h2>Brightness</h2></div></div>
            <div class="range-head"><div><b>Panel backlight</b><div class="muted" style="font-size:12px;margin-top:3px">Shared with the physical TypeN display menu</div></div><div class="range-value" id="brightnessValue">40%</div></div>
            <input class="range" id="brightnessSlider" type="range" min="5" max="100" step="1" value="40">
            <div class="save-row"><button class="btn primary" onclick="saveBrightness()">Apply brightness</button></div>
          </article>

          <article class="card">
            <div class="card-title"><div><div class="eyebrow">Security</div><h2>Admin PIN</h2></div><span class="badge" id="adminPinState">Off</span></div>
            <div class="notice">The TypeN Wi-Fi network stays quick to join. When enabled, the PIN protects the management page and API instead.</div>
            <div class="field">
              <label for="adminPinInput">New admin PIN</label>
              <input id="adminPinInput" type="password" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="8" autocomplete="new-password" placeholder="4вЂ“8 digits">
            </div>
            <div class="actions" style="margin-top:13px"><button class="btn primary" onclick="saveAdminPin()">Set / change PIN</button><button id="disableAdminPinBtn" class="btn ghost" onclick="disableAdminPin()">Disable PIN</button></div>
          </article>

          <article class="card danger-card">
            <div class="card-title"><div><div class="eyebrow">Recovery</div><h2>Factory reset</h2></div></div>
            <div class="notice">Clears TypeN settings, the active-media selection, and the Admin PIN, then reboots. SD media and installed firmware are kept.</div>
            <div class="save-row"><button class="btn danger" onclick="openFactoryReset()">Factory reset</button></div>
          </article>

          <article class="card">
            <div class="card-title"><div><div class="eyebrow">Media</div><h2>Thumbnail cache</h2></div></div>
            <div class="notice">TypeN stores generated media previews in the configured thumbnail cache. Previews are refreshed automatically when the source media changes.</div>
          </article>
        </div>
      </section>

      <section id="view-update" class="view">
        <div class="hero"><div><h1>Update</h1><p>Install TypeN firmware from this device or directly from the SD card.</p></div></div>

        <div class="grid dashboard">
          <div class="section-stack">
            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Browser update</div><h2>Upload firmware</h2></div></div>
              <div class="upload-zone">
                <label class="filepick">
                  <input id="firmwareFile" type="file" accept=".bin,application/octet-stream">
                  <div><strong id="firmwareFileLabel">Choose TypeN firmware</strong><span>Select the application .bin produced by ESP-IDF</span></div>
                </label>
                <div class="progress"><i id="firmwareProgress"></i></div>
                <div class="actions"><button id="firmwareUploadBtn" class="btn primary" onclick="uploadFirmware()">Install firmware</button></div>
              </div>
            </article>

            <article class="card">
              <div class="card-title"><div><div class="eyebrow">SD update</div><h2>Install from SD card</h2></div></div>
              <div class="field">
                <label for="sdUpdatePath">Firmware path</label>
                <input id="sdUpdatePath" type="text" maxlength="511" spellcheck="false" autocomplete="off" value="/sdcard/typen/update/TypeN.bin">
              </div>
              <div class="save-row"><button id="sdUpdateBtn" class="btn primary" onclick="installFromSd()">Check &amp; install</button></div>
            </article>
          </div>

          <div class="section-stack">
            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Updater</div><h2>Firmware status</h2></div><span class="badge" id="updateState">IDLE</span></div>
              <div class="update-status">
                <div class="update-status-row"><span>Current version</span><strong id="runningVersion">вЂ”</strong></div>
                <div class="update-status-row"><span>Current identity</span><strong id="runningIdentity">вЂ”</strong></div>
                <div class="update-status-row"><span>Running slot</span><strong id="runningSlot">вЂ”</strong></div>
                <div class="update-status-row"><span>Boot slot</span><strong id="bootSlot">вЂ”</strong></div>
                <div class="update-status-row"><span>Image state</span><strong id="imageState">вЂ”</strong></div>
                <div class="update-status-row"><span>New version</span><strong id="targetVersion">вЂ”</strong></div>
                <div class="update-status-row"><span>New identity</span><strong id="targetIdentity">вЂ”</strong></div>
                <div class="update-status-row"><span>Target slot</span><strong id="targetSlot">вЂ”</strong></div>
                <div class="update-status-row"><span>Progress</span><strong id="updatePercent">0%</strong></div>
                <div class="update-status-row"><span>Status</span><strong id="updateMessage">Updater ready</strong></div>
              </div>
              <div class="progress" style="margin-top:13px"><i id="updateProgress"></i></div>
              <div id="updateNotice" class="update-notice">Updater ready. No firmware update is in progress.</div>
            </article>

            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Recovery</div><h2>Update history &amp; rollback</h2></div></div>
              <div class="update-status">
                <div class="update-status-row"><span>Last update</span><strong id="lastUpdateResult">None</strong></div>
                <div class="update-status-row"><span>Last version</span><strong id="lastUpdateVersion">вЂ”</strong></div>
                <div class="update-status-row"><span>Last slot</span><strong id="lastUpdateSlot">вЂ”</strong></div>
                <div class="update-status-row"><span>Rollback image</span><strong id="rollbackState">вЂ”</strong></div>
                <div class="update-status-row"><span>Last rejected image</span><strong id="invalidImage">None</strong></div>
              </div>
              <div class="notice" style="margin-top:13px">A newly installed image is confirmed only after TypeN reaches its core-ready checkpoint. If it cannot do that, ESP-IDF returns to the previous working firmware.</div>
            </article>
          </div>
        </div>
      </section>

      <section id="view-diagnostics" class="view">
        <div class="hero"><div><h1>Diagnostics</h1><p>Live device health and support information from the current TypeN session.</p></div><div class="hero-meta"><button class="btn ghost" onclick="loadDiagnostics()">Refresh</button></div></div>
        <div class="grid dashboard">
          <div class="section-stack">
            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Runtime</div><h2>Device health</h2></div></div>
              <div class="setting-row"><b>Uptime</b><span id="diagUptime">вЂ”</span></div>
              <div class="setting-row"><b>Reset reason</b><span id="diagReset">вЂ”</span></div>
              <div class="setting-row"><b>Internal heap free</b><span id="diagHeapFree">вЂ”</span></div>
              <div class="setting-row"><b>Internal heap minimum</b><span id="diagHeapMin">вЂ”</span></div>
              <div class="setting-row"><b>PSRAM free</b><span id="diagPsramFree">вЂ”</span></div>
              <div class="setting-row"><b>PSRAM minimum</b><span id="diagPsramMin">вЂ”</span></div>
            </article>

            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Storage</div><h2>SD card</h2></div><span class="badge" id="diagSdState">вЂ”</span></div>
              <div class="setting-row"><b>Total</b><span id="diagSdTotal">вЂ”</span></div>
              <div class="setting-row"><b>Used</b><span id="diagSdUsed">вЂ”</span></div>
              <div class="setting-row"><b>Free</b><span id="diagSdFree">вЂ”</span></div>
              <div class="setting-row"><b>Media files</b><span id="diagMediaCount">вЂ”</span></div>
              <div class="field" style="margin-top:13px"><label>Active media</label><div class="readonly-box pathline" id="diagSelectedPath">None</div></div>
            </article>
          </div>

          <div class="section-stack">
            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Firmware</div><h2>Runtime image</h2></div></div>
              <div class="setting-row"><b>Version</b><span id="diagVersion">вЂ”</span></div>
              <div class="setting-row"><b>Identity</b><span id="diagIdentity">вЂ”</span></div>
              <div class="setting-row"><b>Running slot</b><span id="diagRunningSlot">вЂ”</span></div>
              <div class="setting-row"><b>Boot slot</b><span id="diagBootSlot">вЂ”</span></div>
              <div class="setting-row"><b>Image state</b><span id="diagImageState">вЂ”</span></div>
              <div class="setting-row"><b>OTA state</b><span id="diagOtaState">вЂ”</span></div>
              <div class="setting-row"><b>Rollback image</b><span id="diagRollback">вЂ”</span></div>
              <div class="setting-row"><b>ESP-IDF</b><span id="diagIdf">вЂ”</span></div>
              <div class="field" style="margin-top:13px"><label>Updater message</label><div class="readonly-box" id="diagOtaMessage">вЂ”</div></div>
            </article>

            <article class="card">
              <div class="card-title"><div><div class="eyebrow">Connectivity</div><h2>Management session</h2></div></div>
              <div class="setting-row"><b>IP address</b><span id="diagIp">вЂ”</span></div>
              <div class="setting-row"><b>Admin PIN</b><span id="diagPin">вЂ”</span></div>
              <div class="setting-row"><b>Last transfer</b><span id="diagTransferState">None</span></div>
              <div class="setting-row"><b>Transfer rate</b><span id="diagTransferRate">вЂ”</span></div>
              <div class="setting-row"><b>Receive timeouts</b><span id="diagTransferTimeouts">вЂ”</span></div>
              <div class="field" style="margin-top:13px"><label>Last transfer file</label><div class="readonly-box pathline" id="diagTransferFile">None</div></div>
              <div class="actions" style="margin-top:13px"><button class="btn ghost" onclick="copyDiagnostics()">Copy report</button></div>
            </article>
          </div>
        </div>
      </section>

      <section id="view-about" class="view">
        <div class="hero"><div><h1>About TypeN</h1><p>Firmware identity, hardware details, and project credits.</p></div></div>
        <div class="identity-hero">
          <div class="identity-main"><small>TypeN firmware</small><div class="identity-version" id="aboutVersion">вЂ”</div></div>
          <div class="identity-chips"><span class="identity-chip" id="aboutVariant">вЂ”</span><span class="identity-chip">ABI <span id="aboutAbi">вЂ”</span></span><span class="identity-chip" id="aboutSlot">вЂ”</span></div>
        </div>
        <div class="about-grid">
          <article class="card">
            <div class="card-title"><div><div class="eyebrow">Project</div><h2>TypeN</h2></div></div>
            <div class="setting-row"><b>Platform</b><span>ESP32-P4 + ESP32-C6</span></div>
            <div class="setting-row"><b>Display</b><span>800 Г— 800 JD9365 MIPI-DSI</span></div>
            <div class="setting-row"><b>Media</b><span>JPEG В· PNG В· GIF В· BMP В· WebP</span></div>
            <div class="setting-row"><b>Control</b><span>Local touch + local WebUI</span></div>
          </article>
          <article class="card">
            <div class="card-title"><div><div class="eyebrow">Technical</div><h2>Runtime identity</h2></div></div>
            <div class="setting-row"><b>Image state</b><span id="aboutImageState">вЂ”</span></div>
            <div class="setting-row"><b>ESP-IDF</b><span id="aboutIdf">вЂ”</span></div>
            <div id="aboutBuildTrigger" class="setting-row secret-trigger"><b>Build</b><span id="aboutBuild">вЂ”</span></div>
          </article>
        </div>
        <article class="card" style="margin-top:14px">
          <div class="card-title"><div><div class="eyebrow">Credits</div><h2>Project acknowledgements</h2></div></div>
          <div class="setting-row"><b>Darkone83</b><span>TypeN design, firmware, and integration</span></div>
          <div class="setting-row"><b>Macho Nacho Productions</b><span>Special thanks</span></div>
        </article>
      </section>

      <div class="bottom-space"></div>
    </main>
  </div>

  <nav class="mobilebar" aria-label="TypeN mobile sections">
    <button class="active" data-view="media">Media</button>
    <button data-view="settings">Settings</button>
    <button data-view="update">Update</button>
    <button data-view="diagnostics">Diag</button>
    <button data-view="about">About</button>
  </nav>
</div>
<div id="deleteConfirm" class="confirm-backdrop" role="dialog" aria-modal="true" aria-labelledby="deleteConfirmTitle">
  <div class="confirm-card danger-confirm">
    <div class="confirm-kicker">Permanent action</div>
    <h3 id="deleteConfirmTitle">Delete media?</h3>
    <p>This permanently removes this file from the TypeN SD card.</p>
    <div id="deleteConfirmName" class="confirm-name"></div>
    <div class="confirm-actions"><button class="btn ghost" onclick="closeDeleteConfirm()">Cancel</button><button id="deleteConfirmButton" class="btn danger" onclick="confirmDelete()">Delete</button></div>
  </div>
</div>
<div id="updateConfirm" class="confirm-backdrop" role="dialog" aria-modal="true" aria-labelledby="updateConfirmTitle">
  <div class="confirm-card">
    <div class="confirm-kicker">Firmware update</div>
    <h3 id="updateConfirmTitle">Install firmware?</h3>
    <p id="updateConfirmText">TypeN will verify the firmware, install it to the inactive OTA slot, and reboot.</p>
    <div id="updateConfirmDetails" class="confirm-name"></div>
    <div class="confirm-actions"><button class="btn ghost" onclick="closeUpdateConfirm()">Cancel</button><button id="updateConfirmButton" class="btn primary" onclick="confirmUpdateAction()">Install update</button></div>
  </div>
</div>
<div id="easterModal" class="confirm-backdrop" role="dialog" aria-modal="true" aria-labelledby="easterTitle">
  <div class="confirm-card easter-card">
    <div class="easter-kicker">Darkone83 hidden mode</div>
    <h3 id="easterTitle">Easter egg active</h3>
    <p>The rotating Darkone83 wireframe is now active on the TypeN display.</p>
    <div class="confirm-actions single"><button id="easterExitButton" class="btn easter" onclick="exitEasterEgg()">Exit</button></div>
  </div>
</div>
<div id="factoryResetConfirm" class="confirm-backdrop" role="dialog" aria-modal="true" aria-labelledby="factoryResetTitle">
  <div class="confirm-card danger-confirm">
    <div class="confirm-kicker">Recovery action</div>
    <h3 id="factoryResetTitle">Factory reset TypeN?</h3>
    <p>This clears device settings, the active-media selection, and Admin PIN. SD media and firmware remain untouched.</p>
    <div class="confirm-actions"><button class="btn ghost" onclick="closeFactoryReset()">Cancel</button><button id="factoryResetButton" class="btn danger" onclick="confirmFactoryReset()">Reset &amp; reboot</button></div>
  </div>
</div>
<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
const $=q=>document.querySelector(q), $$=q=>[...document.querySelectorAll(q)];
let media=[], info={}, diagnostics={};
let authState={enabled:false,authenticated:false,lockoutSeconds:0};
const nativeFetch=window.fetch.bind(window);
window.fetch=async(...args)=>{
  const r=await nativeFetch(...args);
  const url=String(args[0]||'');
  if(r.status===401&&!url.startsWith('/api/auth/'))showAuthGate('Admin session expired.');
  return r;
};
let easterTapCount=0,easterTapReset=0,easterPollTimer=0,easterBusy=false;

function esc(v){return String(v == null ? '' : v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function size(n){n=Number(n)||0;if(n<1024)return n+' B';if(n<1048576)return(n/1024).toFixed(1)+' KB';if(n<1073741824)return(n/1048576).toFixed(1)+' MB';return(n/1073741824).toFixed(2)+' GB'}
function duration(ms){ms=Math.max(0,Number(ms)||0);let s=Math.floor(ms/1000),d=Math.floor(s/86400);s%=86400;let h=Math.floor(s/3600);s%=3600;let m=Math.floor(s/60);s%=60;return(d?d+'d ':'')+(h||d?h+'h ':'')+(m||h||d?m+'m ':'')+s+'s'}
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),2600)}
function setView(name){
  $$('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+name));
  $$('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===name));
  history.replaceState(null,'','#'+name);
  window.scrollTo({top:0,behavior:'smooth'});
  if(name==='diagnostics'&&managementStarted)loadDiagnostics();
}
$$('[data-view]').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view)));

function setDialogVisible(id,visible){
  const el=$(id);if(!el)return;el.classList.toggle('show',visible);
  document.body.style.overflow=$$('.confirm-backdrop.show').length?'hidden':'';
}
function showAuthGate(message=''){
  $('#authGate').classList.remove('hidden');
  $('#authStatusText').textContent=message;
  setTimeout(()=>$('#authPin').focus(),0);
}
function hideAuthGate(){
  $('#authGate').classList.add('hidden');
  $('#authStatusText').textContent='';
}
function updateAdminPinUi(){
  const on=!!authState.enabled;
  $('#adminPinState').textContent=on?'On':'Off';
  $('#disableAdminPinBtn').disabled=!on;
}
async function loadAuthStatus(){
  try{
    const r=await nativeFetch('/api/auth/status',{cache:'no-store'});if(!r.ok)throw 0;
    authState=await r.json();updateAdminPinUi();return authState;
  }catch(e){authState={enabled:false,authenticated:false,lockoutSeconds:0};return authState}
}
async function unlockAdmin(){
  const pin=$('#authPin').value.trim(),btn=$('#authUnlockBtn');
  if(!/^\d{4,8}$/.test(pin)){showAuthGate('Enter the 4вЂ“8 digit Admin PIN.');return}
  btn.disabled=true;$('#authStatusText').textContent='CheckingвЂ¦';
  try{
    const body=new URLSearchParams({pin}).toString();
    const r=await nativeFetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=utf-8'},body});
    const msg=await r.text();
    if(!r.ok)throw new Error(msg||'Incorrect PIN');
    $('#authPin').value='';await loadAuthStatus();hideAuthGate();await startManagementApp();
  }catch(e){showAuthGate(e.message||'Unable to unlock TypeN')}finally{btn.disabled=false}
}
$('#authPin').addEventListener('keydown',e=>{if(e.key==='Enter')unlockAdmin()});
async function saveAdminPin(){
  const pin=$('#adminPinInput').value.trim();
  if(!/^\d{4,8}$/.test(pin)){toast('PIN must be 4вЂ“8 digits.');return}
  try{
    const body=new URLSearchParams({pin}).toString();
    const r=await fetch('/api/auth/pin',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=utf-8'},body});
    const msg=await r.text();if(!r.ok)throw new Error(msg||'Unable to save PIN');
    $('#adminPinInput').value='';await loadAuthStatus();toast('Admin PIN enabled');
  }catch(e){toast(e.message||'Unable to save PIN')}
}
async function disableAdminPin(){
  if(!authState.enabled)return;
  try{
    const r=await fetch('/api/auth/pin',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=utf-8'},body:'disable=1'});
    const msg=await r.text();if(!r.ok)throw new Error(msg||'Unable to disable PIN');
    await loadAuthStatus();toast('Admin PIN disabled');
  }catch(e){toast(e.message||'Unable to disable PIN')}
}
function openFactoryReset(){setDialogVisible('#factoryResetConfirm',true)}
function closeFactoryReset(){if(!$('#factoryResetButton').disabled)setDialogVisible('#factoryResetConfirm',false)}
async function confirmFactoryReset(){
  const b=$('#factoryResetButton');b.disabled=true;b.textContent='ResettingвЂ¦';
  try{
    const r=await fetch('/api/factory-reset',{method:'POST',cache:'no-store'});
    const msg=await r.text();if(!r.ok)throw new Error(msg||'Factory reset failed');
    setDialogVisible('#factoryResetConfirm',false);toast('Factory reset complete. TypeN is rebooting.');
    setTimeout(()=>location.reload(),3500);
  }catch(e){toast(e.message||'Factory reset failed');b.disabled=false;b.textContent='Reset & reboot'}
}
$('#factoryResetConfirm').addEventListener('click',e=>{if(e.target.id==='factoryResetConfirm')closeFactoryReset()});
document.addEventListener('keydown',e=>{
  if(e.key!=='Escape')return;
  if($('#factoryResetConfirm').classList.contains('show')){closeFactoryReset();return}
  if($('#deleteConfirm').classList.contains('show')){closeDeleteConfirm();return}
  if($('#updateConfirm').classList.contains('show')){closeUpdateConfirm();return}
});

function showEasterEggModal(){
  $('#easterModal').classList.add('show');
  if(!easterPollTimer)easterPollTimer=setInterval(pollEasterEggStatus,700);
}
function hideEasterEggModal(){
  $('#easterModal').classList.remove('show');
  if(easterPollTimer){clearInterval(easterPollTimer);easterPollTimer=0}
}
async function pollEasterEggStatus(){
  try{
    const r=await fetch('/api/info',{cache:'no-store'});if(!r.ok)return;
    const s=await r.json();if(!s.easterEggActive)hideEasterEggModal();
  }catch(e){}
}
async function startEasterEgg(){
  if(easterBusy)return;easterBusy=true;
  try{
    const r=await fetch('/api/easter-egg/start',{method:'POST',cache:'no-store'});
    if(!r.ok)throw new Error((await r.text())||'Unable to start Easter egg');
    showEasterEggModal();
  }catch(e){toast(e.message||'Unable to start Easter egg')}finally{easterBusy=false}
}
async function exitEasterEgg(){
  if(easterBusy)return;easterBusy=true;const b=$('#easterExitButton');b.disabled=true;b.textContent='ExitingвЂ¦';
  try{
    const r=await fetch('/api/easter-egg/exit',{method:'POST',cache:'no-store'});
    if(!r.ok)throw new Error((await r.text())||'Unable to exit Easter egg');
    hideEasterEggModal();toast('Easter egg closed');
  }catch(e){toast(e.message||'Unable to exit Easter egg')}finally{b.disabled=false;b.textContent='Exit';easterBusy=false}
}
function handleBuildEasterTap(){
  clearTimeout(easterTapReset);easterTapCount++;
  easterTapReset=setTimeout(()=>{easterTapCount=0},2500);
  if(easterTapCount<5)return;
  clearTimeout(easterTapReset);easterTapCount=0;startEasterEgg();
}
$('#aboutBuildTrigger').addEventListener('click',handleBuildEasterTap);

function renderDiagnostics(){
  const d=diagnostics||{};
  $('#diagUptime').textContent=duration(d.uptimeMs);
  $('#diagReset').textContent=d.resetReason||'вЂ”';
  $('#diagHeapFree').textContent=size(d.internalHeapFree);
  $('#diagHeapMin').textContent=size(d.internalHeapMinimum);
  $('#diagPsramFree').textContent=size(d.psramFree);
  $('#diagPsramMin').textContent=size(d.psramMinimum);
  $('#diagSdState').textContent=d.sdAvailable?'Ready':'Unavailable';
  $('#diagSdTotal').textContent=d.sdAvailable?size(d.sdTotal):'вЂ”';
  $('#diagSdUsed').textContent=d.sdAvailable?size(d.sdUsed):'вЂ”';
  $('#diagSdFree').textContent=d.sdAvailable?size(d.sdFree):'вЂ”';
  $('#diagMediaCount').textContent=String(d.mediaCount == null ? '-' : d.mediaCount);
  $('#diagSelectedPath').textContent=d.selectedPath||'None';
  $('#diagVersion').textContent=d.version||'вЂ”';
  $('#diagIdentity').textContent=d.variant?(d.variant+(d.firmwareAbi?' / ABI '+d.firmwareAbi:'')):'вЂ”';
  $('#diagRunningSlot').textContent=d.runningSlot||'вЂ”';
  $('#diagBootSlot').textContent=d.bootSlot||'вЂ”';
  $('#diagImageState').textContent=d.imageState||'вЂ”';
  $('#diagOtaState').textContent=d.otaState||'вЂ”';
  $('#diagRollback').textContent=d.rollbackPossible?'Available':'Not available';
  $('#diagIdf').textContent=d.idfVersion||'вЂ”';
  $('#diagOtaMessage').textContent=d.otaMessage||'вЂ”';
  $('#diagIp').textContent=d.ip||'вЂ”';
  $('#diagPin').textContent=d.adminPinEnabled?'Enabled':'Disabled';
  $('#diagTransferState').textContent=d.transferValid?(d.transferSuccess?'Success':'Failed'):'None';
  $('#diagTransferRate').textContent=d.transferValid&&d.transferKibPerSecond?d.transferKibPerSecond+' KiB/s':'вЂ”';
  $('#diagTransferTimeouts').textContent=d.transferValid?String(d.transferTimeouts||0):'вЂ”';
  $('#diagTransferFile').textContent=d.transferValid&&d.transferFile?d.transferFile:'None';
}
async function loadDiagnostics(){
  try{
    const r=await fetch('/api/diagnostics',{cache:'no-store'});if(!r.ok)throw new Error(await r.text());
    diagnostics=await r.json();renderDiagnostics();
  }catch(e){toast(e.message||'Unable to load diagnostics')}
}
function diagnosticsReport(){
  const d=diagnostics||{};
  return [
    'TypeN diagnostics',
    'Version: '+(d.version||'вЂ”'),
    'Identity: '+(d.variant||'вЂ”')+(d.firmwareAbi?' / ABI '+d.firmwareAbi:''),
    'Running slot: '+(d.runningSlot||'вЂ”'),
    'Boot slot: '+(d.bootSlot||'вЂ”'),
    'Image state: '+(d.imageState||'вЂ”'),
    'OTA: '+(d.otaState||'вЂ”')+' - '+(d.otaMessage||'вЂ”'),
    'ESP-IDF: '+(d.idfVersion||'вЂ”'),
    'Uptime: '+duration(d.uptimeMs),
    'Reset reason: '+(d.resetReason||'вЂ”'),
    'Internal heap: '+size(d.internalHeapFree)+' free / '+size(d.internalHeapMinimum)+' minimum',
    'PSRAM: '+size(d.psramFree)+' free / '+size(d.psramMinimum)+' minimum',
    'SD: '+(d.sdAvailable?(size(d.sdFree)+' free / '+size(d.sdTotal)+' total'):'unavailable'),
    'Media count: '+String(d.mediaCount == null ? '-' : d.mediaCount),
    'Active media: '+(d.selectedPath||'None'),
    'IP: '+(d.ip||'вЂ”'),
    'Admin PIN: '+(d.adminPinEnabled?'enabled':'disabled'),
    'Last transfer: '+(d.transferValid?((d.transferSuccess?'success':'failed')+' '+(d.transferFile||'')+' '+(d.transferKibPerSecond||0)+' KiB/s, '+(d.transferTimeouts||0)+' timeouts'):'none')
  ].join('\n');
}
async function copyDiagnostics(){
  const report=diagnosticsReport();
  try{
    if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(report)}
    else{const t=document.createElement('textarea');t.value=report;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();document.execCommand('copy');t.remove()}
    toast('Diagnostics copied');
  }catch(e){toast('Unable to copy diagnostics')}
}

async function loadInfo(){
  try{
    const r=await fetch('/api/info',{cache:'no-store'}); if(!r.ok)throw 0; info=await r.json();
    $('#ip').textContent=info.ip||'192.168.4.1';
    $('#uploadPath').textContent=info.uploadPath||'вЂ”';
    $('#settingsSelectedPath').textContent=info.selectedPath||'None';
    $('#uploadPathInput').value=info.uploadPath||'/sdcard/typen/media';
    $('#thumbnailPathInput').value=info.thumbnailPath||'/sdcard/typen/thumbs';
    const b=Number(info.brightness)||40;
    $('#brightnessSlider').value=String(b);
    $('#brightnessValue').textContent=b+'%';
    $('#statVersion').textContent=info.version||'вЂ”';
    $('#statSlot').textContent=info.runningSlot||'вЂ”';
    $('#statIp').textContent=info.ip||'вЂ”';
    $('#statActive').textContent=info.selectedPath?'YES':'IDLE';
    $('#aboutVersion').textContent=info.version||'вЂ”';
    $('#aboutVariant').textContent=info.firmwareVariant||'вЂ”';
    $('#aboutAbi').textContent=info.firmwareAbi?String(info.firmwareAbi):'вЂ”';
    $('#aboutBuild').textContent=info.build||'вЂ”';
    $('#aboutSlot').textContent=info.runningSlot||'вЂ”';
    $('#aboutImageState').textContent=info.imageState||'вЂ”';
    $('#aboutIdf').textContent=info.idfVersion||'вЂ”';
    if(info.easterEggActive)showEasterEggModal();else if($('#easterModal').classList.contains('show'))hideEasterEggModal();
  }catch(e){$('#ip').textContent='TypeN local'}
}

let thumbLoadGeneration=0;

function startThumbLoads(){
  const generation=++thumbLoadGeneration;
  const queue=[...document.querySelectorAll('#mediaGrid img[data-thumb]')];
  let active=0;
  const pump=()=>{
    if(generation!==thumbLoadGeneration)return;
    while(active<2&&queue.length){
      const img=queue.shift();
      if(!img||!img.isConnected)continue;
      const url=img.dataset.thumb;
      if(!url)continue;
      active++;
      const done=()=>{active--;img.onload=null;img.onerror=null;if(generation===thumbLoadGeneration)pump()};
      img.onload=done;
      img.onerror=()=>{img.style.display='none';done()};
      delete img.dataset.thumb;
      img.src=url;
    }
  };
  pump();
}

function render(){
  const q=$('#search').value.trim().toLowerCase();
  const list=media.filter(m=>!q||m.name.toLowerCase().includes(q)||m.path.toLowerCase().includes(q));
  $('#mediaCount').textContent=media.length+' item'+(media.length===1?'':'s');
  $('#statMedia').textContent=media.length;
  const active=media.find(m=>m.selected);
  $('#selectedName').textContent=active?active.name:'No active media';
  $('#selectedType').textContent=active?active.type:'IDLE';
  $('#selectedPath').textContent=active?active.path:(info.selectedPath||'вЂ”');
  $('#settingsSelectedPath').textContent=active?active.path:(info.selectedPath||'None');

  if(!list.length){$('#mediaGrid').innerHTML='<div class="empty">No matching media.</div>';return}
  $('#mediaGrid').innerHTML=list.map(m=>{
    const thumb='/api/thumb?path='+encodeURIComponent(m.path);
    return `<article class="media ${m.selected?'active':''}" ${m.selected?'aria-current="true"':''}>
      <div class="thumb"><span class="fallback">${esc(m.type)}</span><img decoding="async" data-thumb="${esc(thumb)}" alt=""></div>
      <div class="media-main">
        <div class="media-name">${esc(m.name)}</div>
        <div class="media-path" title="${esc(m.path)}">${esc(m.path)}</div>
        <div class="media-meta"><span class="badge">${esc(m.type)}</span><span>${size(m.size)}</span>${m.selected?'<span class="active-state">в—Џ ACTIVE</span>':''}</div>
      </div>
      <div class="media-actions">
        ${m.selected?'<button class="btn active-btn" disabled>Active</button>':`<button class="btn primary" onclick='selectMedia(${JSON.stringify(m.path)})'>Activate</button>`}
        <button class="btn danger" onclick='askDelete(${JSON.stringify(m.path)},${JSON.stringify(m.name)})'>Delete</button>
      </div>
    </article>`}).join('');
  startThumbLoads();
}

async function refreshMedia(){
  $('#mediaGrid').innerHTML='<div class="empty">Refreshing libraryвЂ¦</div>';
  try{
    const r=await fetch('/api/media',{cache:'no-store'}); if(!r.ok)throw 0;
    media=await r.json(); render(); await loadInfo();
  }catch(e){$('#mediaGrid').innerHTML='<div class="empty">Unable to read the SD media library.</div>'}
}
$('#search').addEventListener('input',render);

$('#brightnessSlider').addEventListener('input',e=>{
  $('#brightnessValue').textContent=String(e.target.value)+'%';
});

async function postSettings(values){
  const body=new URLSearchParams(values).toString();
  const r=await fetch('/api/settings',{
    method:'POST',
    headers:{'Content-Type':'application/x-www-form-urlencoded;charset=utf-8'},
    body
  });
  const t=await r.text();
  if(!r.ok)throw new Error(t||'Settings update failed');
  await loadInfo();
  return t;
}

async function savePaths(){
  const upload=$('#uploadPathInput').value.trim();
  const thumbs=$('#thumbnailPathInput').value.trim();
  if(!upload.startsWith('/sdcard')||!thumbs.startsWith('/sdcard')){
    toast('Paths must stay on /sdcard');
    return;
  }
  try{
    await postSettings({uploadPath:upload,thumbnailPath:thumbs});
    toast('Paths saved');
  }catch(e){toast(e.message||'Unable to save paths')}
}

async function saveBrightness(){
  const value=$('#brightnessSlider').value;
  try{
    await postSettings({brightness:value});
    toast('Brightness applied');
  }catch(e){toast(e.message||'Unable to set brightness')}
